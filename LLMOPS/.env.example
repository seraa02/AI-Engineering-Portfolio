# Copy to .env and fill in real values.
# NEVER commit the actual .env file.

# Redis
REDIS_URL=redis://localhost:6379/0

# Provider API keys (optional: system degrades gracefully without them)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Circuit breaker tuning
CB_ERROR_RATE_THRESHOLD=0.5
CB_P95_LATENCY_THRESHOLD_MS=5000.0
CB_WINDOW_SIZE=20
CB_HALF_OPEN_PROBES=3
CB_OPEN_DURATION_SECONDS=30

# Retry
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=30.0

# Hedging
HEDGE_TIMEOUT_SECONDS=2.0
