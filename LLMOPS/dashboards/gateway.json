{
  "__inputs": [{"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus"}],
  "title": "LLM Gateway",
  "uid": "llm-gateway",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "Requests/sec by Provider",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [{"datasource": {"type": "prometheus"}, "expr": "rate(gateway_requests_total[1m])", "legendFormat": "{{provider}} {{status}}"}]
    },
    {
      "id": 2,
      "title": "Error Rate by Provider",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [{"datasource": {"type": "prometheus"}, "expr": "rate(gateway_error_total[1m])", "legendFormat": "{{provider}} {{error_type}}"}]
    },
    {
      "id": 3,
      "title": "p95 Latency (seconds)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [{"datasource": {"type": "prometheus"}, "expr": "histogram_quantile(0.95, rate(gateway_request_duration_seconds_bucket[5m]))", "legendFormat": "p95 {{provider}}"}]
    },
    {
      "id": 4,
      "title": "Circuit Breaker State",
      "type": "stat",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [{"datasource": {"type": "prometheus"}, "expr": "circuit_breaker_state", "legendFormat": "{{provider}}"}],
      "options": {"colorMode": "background"},
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "CLOSED", "color": "green"}, "1": {"text": "OPEN", "color": "red"}, "2": {"text": "HALF_OPEN", "color": "yellow"}}}]}}
    },
    {
      "id": 5,
      "title": "Failover Events",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "targets": [{"datasource": {"type": "prometheus"}, "expr": "rate(gateway_failover_total[1m])", "legendFormat": "{{from_provider}} → {{to_provider}}"}]
    },
    {
      "id": 6,
      "title": "Queue Depth",
      "type": "gauge",
      "gridPos": {"x": 12, "y": 16, "w": 6, "h": 8},
      "targets": [{"datasource": {"type": "prometheus"}, "expr": "gateway_queue_depth", "legendFormat": "{{queue_type}}"}]
    },
    {
      "id": 7,
      "title": "Cost/hour by Tenant",
      "type": "bargauge",
      "gridPos": {"x": 18, "y": 16, "w": 6, "h": 8},
      "targets": [{"datasource": {"type": "prometheus"}, "expr": "rate(gateway_cost_usd_total[1h]) * 3600", "legendFormat": "{{tenant}} / {{feature}}"}]
    }
  ]
}
