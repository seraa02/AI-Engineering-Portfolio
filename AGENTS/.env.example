# Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Tavily API key (https://tavily.com)
TAVILY_API_KEY=tvly-...

# Redis connection URL
REDIS_URL=redis://localhost:6379

# Redis TTL in seconds (default: 24h)
REDIS_TTL_SECONDS=86400

# Models (change to adjust cost/quality tradeoff)
PLANNER_MODEL=claude-haiku-4-5
SUPERVISOR_MODEL=claude-haiku-4-5
RESEARCHER_MODEL=claude-haiku-4-5
WRITER_MODEL=claude-sonnet-4-6

# Budget defaults (can be overridden per-request via API)
MAX_SUBQUESTIONS=5
MAX_SEARCHES_PER_SUBQUESTION=3
MAX_TOTAL_TOKENS=100000
WALL_CLOCK_TIMEOUT_SECONDS=300

# API server
API_HOST=0.0.0.0
API_PORT=8000
